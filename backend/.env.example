# PharmaCycle AI - Backend Environment Configuration (Example)
PROJECT_NAME="PharmaCycle AI - Smart Pharmaceutical Waste Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./pharmacycle.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Configuration
HOST=127.0.0.1
PORT=8000

# File Upload & Image Retention Policy (Section 8)
# Restricts maximum upload size in bytes (default 5MB = 5242880)
MAX_UPLOAD_SIZE_BYTES=5242880
# By default, images are processed in-memory and NOT stored beyond processing.
# Set RETAIN_UPLOADED_IMAGES=true only if persistent image audit archive is required.
RETAIN_UPLOADED_IMAGES=false
UPLOAD_DIR=./uploads

# AI Model Configuration (Section 4B)
# Options: "demo" (deterministic simulation) or "real" (loads model from MODEL_PATH)
MODEL_MODE=demo
MODEL_PATH=./models/waste_classifier.onnx
